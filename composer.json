{
    "name": "ffi/location",
    "type": "library",
    "description": "PHP library for determining the physical location of binaries",
    "license": "MIT",
    "keywords": ["ffi", "bin", "location", "utility"],
    "support": {
        "source": "https://github.com/php-ffi/location",
        "issues": "https://github.com/php-ffi/location/issues",
        "docs": "https://github.com/php-ffi/location/blob/master/README.md"
    },
    "authors": [
        {
            "name": "Nesmeyanov Kirill",
            "email": "nesk@xakep.ru",
            "homepage": "https://nesk.me",
            "role": "maintainer"
        }
    ],
    "require": {
        "php": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "FFI\\Location\\": "src"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.0|^12.0|^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "FFI\\Location\\Tests\\": "tests"
        }
    },
    "scripts-aliases": {
        "test:unit": ["phpunit", "unit"],
        "linter:check": ["linter", "stan"],
        "phpcs:check": ["phpcs", "cs"],
        "phpcs:fix": ["fix", "psr", "per"]
    },
    "scripts": {
        "test": [
            "@test:unit"
        ],
        "test:unit": "phpunit --testsuite unit --testdox",
        "linter:check": "phpstan analyse --configuration phpstan.neon --memory-limit 256M",
        "linter:baseline": "@linter:check --generate-baseline",
        "phpcs:check": "@phpcs:fix --dry-run",
        "phpcs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes --verbose --diff"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev",
            "dev-master": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
